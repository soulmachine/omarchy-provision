[Unit]
Description=Paseo daemon

[Service]
# bash -lc, not the binary: ~/.bashrc exports CLIPROXY_API_KEY / CLIPROXY_BASE_URL above its
# interactive guard, and the agent CLIs this daemon spawns need them. `paseo` is found by
# name, so every start runs whatever install is current.
ExecStart=/bin/bash -lc 'exec paseo daemon run'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
