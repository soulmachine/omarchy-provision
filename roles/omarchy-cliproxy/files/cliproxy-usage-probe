#!/usr/bin/python3
"""cliproxy-usage-probe — Claude and Codex rate limits for one gateway-only host.

A host with no native Claude or Codex login (mac-mini-2018-omarchy, coding-agent
Q352, Q365, Q366) cannot ask the vendors for its limits, and the gateway strips the
rate-limit headers from its answers. mac-mini-m2 holds the account tokens, so the
host's omarchy-cliproxy-usage runs this there, from stdin, and gets back only the
answers, never a token:

- Claude: Anthropic's OAuth usage endpoint, for the account the cliproxy-key-routing
  plugin now sends the host to. That is the first account in the host's order that
  has not hit its session or weekly limit. The accounts passed over travel as
  fallbackFrom. If every account is at its limit, the first one is shown.
- Codex: ChatGPT's usage endpoint, for the pool's one Codex account. Only the plan
  and the rate-limit windows travel; the answer also names the user and account.

It prints pairs of lines, a file name and its JSON. The host stores them in
~/.local/state/cliproxy/, where local patches to Omarchy's
omarchy-agent-usage-{claude,codex} collectors read them for the Agents bar.

Usage: ssh mac-mini-m2 /usr/bin/python3 - <host> < cliproxy-usage-probe
"""

from __future__ import annotations

import datetime as dt
import json
import re
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

AUTH_DIR = Path.home() / ".cli-proxy-api"
ROUTING = AUTH_DIR / "plugins" / "host-routing.yaml"
CLAUDE_ENDPOINT = "https://api.anthropic.com/api/oauth/usage"
CODEX_ENDPOINT = "https://chatgpt.com/backend-api/wham/usage"


# stderr reaches the host's journal through ssh.
def log(message: str) -> None:
    print(message, file=sys.stderr)


# The sidecar is the plugin's own YAML subset: `- key:` starts a row, `name:` and
# `order: [a, b]` follow. Read just enough of it to map host -> account order.
def routing_orders() -> dict[str, list[str]]:
    orders: dict[str, list[str]] = {}
    name = ""
    for line in ROUTING.read_text(encoding="utf-8").splitlines():
        line = line.split("#", 1)[0].strip()
        if line.startswith("- key:"):
            name = ""
        elif line.startswith("name:"):
            name = line.split(":", 1)[1].strip().strip("\"'")
        elif line.startswith("order:") and name:
            match = re.search(r"\[([^\]]*)\]", line)
            order = [a.strip().strip("\"'") for a in match.group(1).split(",")] if match else []
            if [a for a in order if a]:
                orders[name] = [a for a in order if a]
    return orders


# The first enabled auth file of a provider, for one account or for any. An expired
# token means the gateway has stopped refreshing it, which is worth an error, not a 401.
def auth_file(provider: str, account: str = "") -> dict:
    for path in sorted(AUTH_DIR.glob(provider + "-*.json")):
        try:
            auth = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        if auth.get("disabled") or (account and str(auth.get("email") or "").lower() != account.lower()):
            continue
        expires = str(auth.get("expired") or "")
        try:
            lapsed = expires != "" and dt.datetime.fromisoformat(expires) <= dt.datetime.now(dt.timezone.utc)
        except ValueError:
            lapsed = False
        if lapsed:
            raise RuntimeError(f"token in {path.name} expired at {expires}; the gateway has not refreshed it")
        return auth
    raise RuntimeError(f"no enabled {provider} auth file{' for ' + account if account else ''} in {AUTH_DIR}")


def get_json(url: str, headers: dict) -> dict:
    request = urllib.request.Request(url, headers=dict(headers, Accept="application/json"))
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            return json.loads(response.read().decode("utf-8", errors="replace"))
    except urllib.error.HTTPError as error:
        raise RuntimeError(f"{url} answered {error.code}") from None


def claude_usage(account: str) -> dict:
    auth = auth_file("claude", account)
    return get_json(CLAUDE_ENDPOINT, {"Authorization": "Bearer " + str(auth.get("access_token") or ""), "anthropic-beta": "oauth-2025-04-20"})


# The plugin moves to the next account once Anthropic refuses this one, which it
# does when the session or weekly window is full. Model-scoped windows only close
# that model, so they do not count.
def at_limit(usage: dict) -> bool:
    for key in ("five_hour", "seven_day", "seven_day_oauth_apps"):
        bucket = usage.get(key)
        try:
            if isinstance(bucket, dict) and float(bucket.get("utilization") or 0) >= 100:
                return True
        except (TypeError, ValueError):
            pass
    return False


def claude_record(order: list[str]) -> dict:
    passed: list[str] = []
    first: dict = {}
    for account in order:
        usage = claude_usage(account)
        first = first or usage
        if not at_limit(usage):
            return {"fetchedAtMs": round(time.time() * 1000), "account": account, "fallbackFrom": passed, "usage": usage}
        passed.append(account)
    return {"fetchedAtMs": round(time.time() * 1000), "account": order[0], "fallbackFrom": [], "usage": first}


def codex_record() -> dict:
    auth = auth_file("codex")
    usage = get_json(CODEX_ENDPOINT, {
        "Authorization": "Bearer " + str(auth.get("access_token") or ""),
        "ChatGPT-Account-Id": str(auth.get("account_id") or ""),
        "User-Agent": "codex_cli_rs",
    })
    return {"fetchedAtMs": round(time.time() * 1000), "account": str(auth.get("email") or ""),
            "usage": {"plan_type": usage.get("plan_type"), "rate_limit": usage.get("rate_limit")}}


def main() -> int:
    if len(sys.argv) != 2:
        log("usage: cliproxy-usage-probe <host>")
        return 2
    host = sys.argv[1]
    files = []
    failed = 0
    try:
        orders = routing_orders()
        if host not in orders:
            raise RuntimeError(f"no row in {ROUTING.name}")
        files.append(("claude-usage.json", claude_record(orders[host])))
    except Exception as error:
        log(f"{host} claude ERROR {error}")
        failed += 1
    try:
        files.append(("codex-usage.json", codex_record()))
    except Exception as error:
        log(f"codex ERROR {error}")
        failed += 1
    sys.stdout.write("".join(name + "\n" + json.dumps(body) + "\n" for name, body in files))
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
