#!/bin/bash
# Weekly reboot check (coding-agent Q364, DECISIONS Q9). The nightly playbook's `pacman` role
# runs `omarchy-update -y`; nothing here updates. `omarchy-update-restart` asks through gum,
# which can't answer under cron, so the reboot decision lives here instead.
exec >>"$HOME/.local/state/omarchy-weekly-update.log" 2>&1
echo "== $(date -Is) reboot check"
flag=$HOME/.local/state/omarchy/reboot-required
if ! pacman -Qqo "/usr/lib/modules/$(uname -r)/vmlinuz" &>/dev/null || [[ -f $flag ]] ||
  readlink "/proc/$(pgrep -x Hyprland)/exe" 2>/dev/null | grep -q deleted; then
  rm -f "$flag" # nothing in Omarchy clears it, so a stale flag would reboot every week
  echo "== $(date -Is) reboot"
  sudo systemctl reboot
fi
